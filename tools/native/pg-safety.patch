+// Inspect every row: BLAS idamax can select a finite row while other rows are NaN.
+static int solver_finite(const double *values, int size) {
+    for(int row = 0; row < size; ++row) if(!isfinite(values[row])) return FALSE;
+    return TRUE;
+}
+
+static double solver_residual_norm(solver_t *solver) {
+    double norm = 0;
+    for(int row = 0; row < solver->m_size; ++row) {
+        double value = fabs(solver->m_residual[row]);
+        if(!isfinite(value)) return NAN;
+        if(value > norm) norm = value;
+    }
+    return norm;
+}
