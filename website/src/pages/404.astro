---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Connection not found"
  description="This WWPG page could not be found. Return to the overview or choose a documentation release."
>
  <section class="container page-hero not-found">
    <p class="eyebrow">404 / OPEN CIRCUIT</p>
    <h1>
      A missing
      <br />
      <span class="text-mint">connection.</span>
    </h1>
    <p class="page-lead">That page isn't on this circuit.</p>
    <div class="button-row">
      <a class="button button-mint" href="/">
        Back to WWPG ↗
      </a>
      <a class="button button-outline" href="/docs/">
        Find your docs ↗
      </a>
    </div>
  </section>
</Layout>
