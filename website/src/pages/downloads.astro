---
import Layout from '../layouts/Layout.astro';
import VersionChoices from '../components/VersionChoices.astro';
import {
  project,
  currentRelease as release,
  assetHref,
  releaseHref,
  docsHref,
  downloadHref,
} from '../data/project';
---

<Layout
  title="Downloads"
  description="Download WWPG and its stationary test worlds. Check the exact Minecraft, NeoForge, CEE, Power Grid, and Java requirements before installing."
>
  <section class="page-hero container">
    <p class="eyebrow">WWPG / DOWNLOADS</p>
    <h1>
      Make the
      <br />
      <span class="text-mint">connection.</span>
    </h1>
    <p class="page-lead">
      The mod, the dependencies, and a place to try it all.
    </p>
  </section>
  <section class="container download-layout">
    <div>
      <div class="release-card">
        <div class="release-heading">
          <span class="eyebrow">CURRENT RELEASE</span>
          <span class="release-badge">{release.channel}</span>
        </div>
        <h2>{release.version}</h2>
        <p>
          Stationary compatibility for CEE and Power Grid. Install the required
          mods separately, on the server and every client.
        </p>
        <div class="button-row">
          <a class="button button-mint" href={downloadHref()}>
            {project.modrinthUrl ? 'Download on Modrinth' : 'Download the mod'}{' '}
            ↓
          </a>
          <a class="text-link" href={releaseHref()}>
            Release notes ↗
          </a>
        </div>
        <div class="download-address">
          <label class="mono" for="download-url">
            DIRECT JAR URL
          </label>
          <div class="copy-field">
            <textarea
              id="download-url"
              readonly
              rows="3"
              aria-label="Direct WWPG jar download URL"
            >{assetHref('jar')}</textarea>
            <button class="copy-button" type="button" hidden>
              Copy URL
            </button>
          </div>
          <p class="copy-feedback" role="status" aria-live="polite"></p>
        </div>
        <a class="small-text text-link" href={assetHref('checksums')}>
          Download checksums ↗
        </a>
      </div>
      <div class="install-summary">
        <span class="eyebrow">BEFORE YOUR FIRST CIRCUIT</span>
        <h3>Install. Configure. Restart.</h3>
        <p>
          Place the required jars in <code>mods</code>, generate the
          configuration, then stop the game or server. Set PG's{' '}
          <code>solverBackend = "NATIVE"</code> and <code>multiTicks = 16</code>{' '}
          before restarting.
        </p>
        <a class="text-link" href={`${docsHref()}install/`}>
          Follow the full installation guide ↗
        </a>
      </div>
    </div>
    <aside class="requirements">
      <span class="eyebrow">EXACT REQUIREMENTS</span>
      <dl>
        {Object.entries(release.requirements).map(([name, version]) => (
          <div>
            <dt>{name}</dt>
            <dd>
              {name === 'NeoForge' ? (
                <VersionChoices version={version} />
              ) : (
                version
              )}
            </dd>
          </div>
        ))}
      </dl>
      <p>
        These are WWPG's requirements. The Ch4oS modpack has its own release and
        dependency set.
      </p>
      <hr />
      <span class="eyebrow">OPTIONAL COMPUTER CONTROL</span>
      <dl>
        {Object.entries(release.optionalRequirements).map(([name, version]) => (
          <div>
            <dt>{name}</dt>
            <dd>{version}</dd>
          </div>
        ))}
      </dl>
      <p>Use both optional mods for the Pinout yard.</p>
    </aside>
  </section>
  <section class="section container" id="worlds">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A WORKSHOP YOU CAN WALK THROUGH</p>
        <h2>
          Start with
          <br />a working world.
        </h2>
      </div>
      <p>
        Install the matching mod set first, then extract the bundle.
        <br />
        Choose a ZIP in <code>worlds</code> and extract its save folder into{' '}
        <code>saves</code>.<br />
        Keep a clean copy for experiments.
      </p>
    </div>
    <div class="button-row">
      <a class="button button-outline" href={assetHref('worlds')}>
        Download the example worlds bundle ↓
      </a>
    </div>
    <div class="world-grid">
      <article>
        <span class="mono text-mint">BASE PROFILE</span>
        <h3>Stationary Test Yard</h3>
        <p>
          Transformers, boards, panels, meters, storage, processing, and a
          playable Nether route.
        </p>
        <p class="bundle-path">
          <code>{`worlds/wwpg-${release.version}-stationary-yard.zip`}</code>
        </p>
      </article>
      <article>
        <span class="mono violet">OPTIONAL PINOUT PROFILE</span>
        <h3>Stationary Test Yard — Pinout</h3>
        <p>
          The base exhibits plus computer-controlled circuits and the supplied{' '}
          <code>wwpg</code> Lua program.
        </p>
        <p class="bundle-path">
          <code>{`worlds/wwpg-${release.version}-stationary-yard-pinout.zip`}</code>
        </p>
      </article>
    </div>
    <p class="world-guide">
      <a class="text-link" href={`${docsHref()}example-worlds/`}>
        Read the exhibit guide ↗
      </a>
    </p>
    <div class="world-grid">
      <article>
        <span class="mono text-mint">
          API {release.api?.version} / ELEVEN STATIONS
        </span>
        <h3>Extension API Workshop</h3>
        <p>
          Nine device models, a CEE storage indicator, and a PG shunt board.
          Install both example addon jars from <code>workshop-mods</code>{' '}
          alongside the required mod set.
        </p>
        <p class="bundle-path">
          <code>{`worlds/wwpg-${release.version}-api-workshop.zip`}</code>
        </p>
        <p class="bundle-path">
          <code>{`worlds/wwpg-${release.version}-api-workshop-pinout.zip`}</code>
        </p>
        <p class="small-text">
          Both editions contain the same stations. Computer exhibits are in the
          Pinout Stationary Yard.
        </p>
      </article>
      <article>
        <span class="mono violet">WORKSHOP RUNTIME ADDONS</span>
        <h3>The two example mods</h3>
        <p>
          Install both jars from the bundle's <code>workshop-mods</code> folder
          on every client and the server for the workshop. Ordinary WWPG
          factories do not require them.
        </p>
        <p class="bundle-path">
          <code>wwpg-api-example-1.0.0.jar</code>
        </p>
        <p class="bundle-path">
          <code>wwpg-upstream-api-example-1.0.0.jar</code>
        </p>
        <a class="text-link" href={`${docsHref()}workshop/`}>
          Workshop guide ↗
        </a>
      </article>
    </div>
  </section>
  <section class="container release-history" id="sdk">
    <p class="eyebrow">FOR ADDON AUTHORS / API {release.api?.version}</p>
    <h2>Your next device starts here.</h2>
    <p>
      Extract the developer SDK bundle, then its Maven repository ZIP in{' '}
      <code>maven</code>. Both compile-time SDKs, sources, POMs, and generated
      Javadoc are included. Use Java 21 and exact API versions. These developer
      artifacts belong in your build environment; the WWPG runtime supplies the
      APIs in game.
    </p>
    <div class="button-row">
      <a class="button button-outline" href={assetHref('sdk')}>
        Download the SDK ↓
      </a>
      <a class="text-link" href={`${docsHref()}developers/`}>
        First integration guide ↗
      </a>
      <a class="text-link" href={`/api/${release.version}/`}>
        Java reference ↗
      </a>
    </div>
    <p class="world-guide">
      The bundle's <code>examples</code> folder contains both standalone source
      ZIPs; <code>api</code> contains the individual API, source, and Javadoc
      jars. Each bundle includes checksums and a <code>START-HERE.md</code>{' '}
      guide.
    </p>
  </section>
  <section class="container release-history">
    <p class="eyebrow">RELEASE HISTORY</p>
    <h2>Keep your versions together.</h2>
    <p>
      Older downloads remain on GitHub. Use the documentation and dependencies
      for your selected release; back up worlds before updating.
    </p>
    <a class="text-link" href={`${project.repository}/releases`}>
      All published releases ↗
    </a>
  </section>
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>('.copy-button');
  const field = document.querySelector<HTMLTextAreaElement>('#download-url');
  const feedback = document.querySelector<HTMLElement>('.copy-feedback');
  if (button && field && feedback) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(field.value);
        feedback.textContent = 'Download URL copied.';
      } catch {
        field.focus();
        field.select();
        feedback.textContent =
          'Copy was unavailable. The URL is selected; press Ctrl+C or use your device’s copy command.';
      }
    });
  }
</script>
