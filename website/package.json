{
  "name": "wwpg-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:docs && astro dev --host 127.0.0.1 --port 4322",
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "check": "npm run prepare:docs && astro check",
    "build": "npm run prepare:docs && astro build",
    "test": "node --test tests/*.test.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "prepare:api": "node scripts/prepare-api.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4322"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "jsdom": "30.1.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
